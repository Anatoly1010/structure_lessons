    marks
    line((0, 0), (2.2, 0), mark: (end: ">", scale: 0.6)); content((2.45, 0), text(size: 7pt, $E_(perp)$))
    line((0, 0), (0, 1.9), mark: (end: ">", scale: 0.6)); content((0, 2.15), text(size: 7pt, $E_(parallel)$))
    line((0, 0), (1.6, 1.35), mark: (end: ">"), stroke: 0.9pt)
    // вектор E: стрелку рисуем сами — accent arrow в математике слишком мелкий
