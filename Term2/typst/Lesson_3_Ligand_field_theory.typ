    earrow((-3.23, 1.5)); earrow((-2.97, 1.5))
    // eg
    line((0.0, 2.5), (0.9, 2.5)); content((1.3, 2.5), $e_g$); content((2.55, 2.5), text(size: 7pt)[$\{d_(z^2), d_(x^2-y^2)\}$])
    // t2g + 2 электрона
